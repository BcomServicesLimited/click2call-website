# ============================================================
# Click2Call Website — .gitignore
# ============================================================

# OS / editor noise
.DS_Store
Thumbs.db
*.log
*.swp
*.swo

# Build tooling — node_modules not committed; build inputs/outputs ARE committed
node_modules/
.npm-cache/
input.css

# Scripts (shell/batch only — Python utility scripts are committed)
*.sh
*.bat

# Draft / temp / backup files
draft-*
temp-*
test-*
*-backup.*
*-copy.*

# Audit / working documents
pricing_audit_report.txt
pricing_audit_report2.txt
conversion_audit_report.md
seo_audit_report.md
google_guidelines_audit_report.md
bing_seo_recommendations.md
keyword_strategy_report.md
sales_presentation_content.md
ai-agents-screenshots-notes.md
brisbane-content.md
case_studies_new.md
llms-full.txt

# Internal operational material — must never be deployed to the public site.
# Both of these were publicly reachable and returning HTTP 200:
#   /knowledge/**                     internal reply rules, policies, pricing notes
#   /help/primary-knowledge-base.html internal support source-of-truth
# Kept on disk for local use; untracked so Cloudflare Pages cannot publish them.
knowledge/
help/primary-knowledge-base.html
